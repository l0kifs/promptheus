# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model Configuration (Free Tier Models)
AI_MODEL_PRIMARY=meta-llama/llama-3.1-8b-instruct:free
AI_MODEL_FALLBACK=google/gemini-2.0-flash-exp:free
AI_MODEL_ALTERNATIVE=mistralai/mistral-7b-instruct:free
AI_MODEL_LIGHTWEIGHT=qwen/qwen2.5-vl-3b-instruct:free

# Model Parameters
MAX_TOKENS_DEFAULT=1024
MAX_TOKENS_FEEDBACK=512
MAX_TOKENS_ASSESSMENT=256
TEMPERATURE_DEFAULT=0.7
TEMPERATURE_ASSESSMENT=0.3
TEMPERATURE_FEEDBACK=0.5

# Database Configuration
DATABASE_URL=sqlite:///./data/promptheus.db

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_REQUESTS=10

# Session Configuration
SESSION_TIMEOUT_MINUTES=15

# Bot Mode Configuration
# Set to 'polling' for development (default), 'webhook' for production
BOT_MODE=polling

# Webhook Configuration (only needed when BOT_MODE=webhook)
# Must be HTTPS URL, e.g., https://yourdomain.com/webhook
WEBHOOK_URL=
# Optional: Secret token for webhook validation (recommended for security)
WEBHOOK_SECRET=
# Port for webhook HTTP server (must be 80, 88, 443, or 8443)
WEBHOOK_PORT=8443
# Path for webhook endpoint
WEBHOOK_PATH=/webhook
